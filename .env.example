APP_NAME=RYH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ryh
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (served over HTTPS) so the session cookie is never sent over plain HTTP.
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Where uploaded documents live: local (storage/app/private) or s3.
DOCUMENTS_DISK=local
QUEUE_CONNECTION=redis

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Server-to-server (PHP -> Reverb container), so this is the compose service name, not localhost.
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http

# Browser-facing — the browser reaches Reverb via the port mapped onto the host.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CHORE_REMINDER_COOLDOWN_MINUTES=60

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOME_MONTHLY=
STRIPE_PRICE_HOME_ANNUAL=
CASHIER_CURRENCY=gbp
CASHIER_CURRENCY_LOCALE=en_GB

ANTHROPIC_API_KEY=
# ANTHROPIC_TEXT_MODEL=claude-haiku-4-5-20251001
# App-wide cap on AI meal plans per day, and where to email when AI credit runs out.
AI_MEAL_PLAN_DAILY_CAP=50
AI_ALERT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_PORT=8090
VITE_PORT=5174
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6380
WWWGROUP=1000
WWWUSER=1000

# Business and contact details for the Terms, Privacy Policy and Support pages
# (config/legal.php). Anything unset shows as "[… to be confirmed]" on those
# pages — fill them all in before launch.
LEGAL_ENTITY_NAME=
# The name the pages trade under; defaults to RYH.
LEGAL_TRADING_NAME=
# sole_trader or limited_company
LEGAL_ENTITY_TYPE=
LEGAL_COMPANY_NUMBER=
LEGAL_ADDRESS=
LEGAL_ICO_REGISTRATION=
LEGAL_HOSTING_PROVIDER=
LEGAL_MAIL_PROVIDER=
LEGAL_ERROR_TRACKER=
LEGAL_BACKUP_RETENTION_DAYS=30
SUPPORT_EMAIL=
# What the Support page promises, e.g. "within two working days" (the default).
SUPPORT_RESPONSE_TIME=
# Defaults to SUPPORT_EMAIL.
PRIVACY_EMAIL=

# Web Push (laravel-notification-channels/webpush). Generate a pair with
# `php artisan webpush:vapid`; without them, Settings → Notifications can't turn
# push on. The subject is a contact push services can reach — `mailto:` or an
# https URL (defaults to mailto:SUPPORT_EMAIL, else APP_URL).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Proxies allowed to set X-Forwarded-* headers ("*" or comma-separated IPs).
# Needed behind a load balancer, and for the phone-testing tunnel
# (scripts/tunnel.sh) — use * locally for that.
TRUSTED_PROXIES=
