includes:
    - vendor/larastan/larastan/extension.neon

# The layer rules (CLAUDE.md), judged by type; their own tests are in
# tests/Unit/PHPStan, with fixtures that break them on purpose.
rules:
    - Tests\PHPStan\QueryBoundaryRule
    - Tests\PHPStan\UserFacingErrorsRule
    - Tests\PHPStan\TypedActionInputRule
    - Tests\PHPStan\TypedRequestValuesRule

parameters:
    level: 8
    paths:
        - app
        - database
        - routes
        - tests
    excludePaths:
        - tests/PHPStan/Fixtures

    # Lets Larastan type model attributes from the schema instead of falling
    # back to `string`, so enum and date casts resolve correctly.
    databaseMigrationsPath:
        - database/migrations

    # Tests run at the same level, minus "might be null" checks: in a test a
    # null already fails loudly at the exact line, so guarding every
    # `$user->household` or `$model->fresh()` would be noise, not safety.
    ignoreErrors:
        -
            message: '#^(Cannot (call method|access property|access offset) .+ on .+\|null|Parameter .+ expects .+, .+\|null given|Offset .+ might not exist on .+\|null|Property .+ does not accept .+\|null)\.$#'
            paths:
                - tests/*
        # `$this->artisan()` is typed PendingCommand|int, but with Laravel's test
        # defaults (mocked console output) it's always the PendingCommand that
        # its documented assertions chain on.
        -
            message: '#^Cannot call method \w+\(\) on Illuminate\\Testing\\PendingCommand\|int\.$#'
            paths:
                - tests/*
