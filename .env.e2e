# Loaded instead of .env when APP_ENV=e2e — the Playwright server (npm run e2e).
# Its own database and file-backed session/cache so a run never touches dev data
# and CI needs nothing beyond MySQL and Mailpit. The key is a throwaway, e2e only.
APP_NAME=RYH
APP_ENV=e2e
APP_KEY=base64:LZeofZgrOGfg9D3oQ/655qf2W79DdFOMdj3zwZPlm7I=
APP_DEBUG=true
APP_URL=http://localhost:8091

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=4

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=testing_e2e
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
# No Reverb in e2e; the bell loads notifications on page load instead.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CHORE_REMINDER_COOLDOWN_MINUTES=60
AI_MEAL_PLAN_DAILY_CAP=50
# Only so AI planning counts as set up: in e2e the agent is faked (App\Ai\Fakes\E2eMealPlan) and never calls out.
ANTHROPIC_API_KEY=e2e-fake-key

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# Only so the bundled Echo client can construct; nothing listens in e2e.
VITE_REVERB_APP_KEY=e2e
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
